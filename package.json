{
  "name": "liftlog",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  },
  "scripts": {
    "android:clean": "pnpm run prebuild:clean && pnpm run android:device",
    "android:release:single-arch": "dotenvx run -f .env.local -- scripts/build-android-release-single-arch.sh",
    "android:device": "EXPO_UNSTABLE_ATLAS=true expo run:android --device",
    "android": "expo run:android",
    "format": "pnpm run prettier:fix",
    "ios": "expo run:ios",
    "lint:fix": "eslint --fix .",
    "lint": "eslint",
    "postinstall": "husky",
    "pre-commit": "lint-staged",
    "prebuild:clean": "expo prebuild --clean",
    "prebuild": "expo prebuild",
    "prepare": "husky",
    "prettier:check": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "start": "expo start",
    "test": "tsx --experimental-test-module-mocks --tsconfig tests/tsconfig.json --import ./tests/setup.ts --test \"tests/**/*.test.ts\"",
    "ts-check": "tsc --noEmit true --project ./tsconfig.json"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "9.1.1"
  },
