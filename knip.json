{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "ignoreBinaries": ["scripts/build-android-release-single-arch.sh"],
  "ignore": ["babel.config.js"],
  "entry": ["tests/**/*.test.ts", "tests/mocks/**/*.ts"],
  "expo": {
    "config": ["app.json", "app.config.{ts,js}"],
    "entry": ["app/**/*.{js,jsx,ts,tsx}", "src/app/**/*.{js,jsx,ts,tsx}"]
  }
}
